# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.eggs/

# Tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
# Hook environments, parked on the Dev Spaces persistent volume by
# PRE_COMMIT_HOME in devfile.yaml so they survive workspace restarts.
.pre-commit-cache/

# Virtual environments
.venv/
venv/
env/

# Generated release artifacts (regenerated by docx-build-all)
exports/*.docx
exports/*.pdf

# Temporary files
*.tmp
*.zip
/*.docx

# Vale packages pulled by `vale sync` (the committed Vocab and DocOps styles
# stay; only downloaded packages are ignored)
dac/vale/styles/RedHat/
dac/vale/styles/write-good/
dac/vale/styles/ai-tells/

# Rendered diagrams
diagrams/exported/*.png
diagrams/exported/*.svg

# OS
.DS_Store
Thumbs.db
